{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://comphy-lab.org/talks/schema/manifest-2.json",
  "title": "CoMPhy Lab talk manifest (schemas 1 and 2)",
  "description": "Generated by tools/talks_build from a Keynote HTML export and talks-src/<slug>/talk.yaml. See docs/SPEC.md section 3.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "slug",
    "title",
    "subtitle",
    "speaker",
    "updated",
    "canvas",
    "media_base",
    "videos",
    "youtube",
    "slides",
    "changelog"
  ],
  "properties": {
    "schema": { "enum": [1, 2] },
    "slug": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "title": { "type": "string", "minLength": 1 },
    "subtitle": { "type": "string" },
    "speaker": { "type": "string", "minLength": 1 },
    "updated": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "canvas": {
      "type": "object",
      "additionalProperties": false,
      "required": ["width", "height"],
      "properties": {
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 }
      }
    },
    "media_base": { "type": "string", "pattern": "^https://media\\.comphy-lab\\.org/talks/[a-z0-9-]+/$" },
    "videos": {
      "type": "object",
      "propertyNames": { "pattern": "^v[0-9]{2,}$" },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["src", "poster", "width", "height", "duration", "credit"],
        "properties": {
          "src": { "$ref": "#/$defs/mp4" },
          "poster": { "$ref": "#/$defs/webp" },
          "width": { "type": "integer", "minimum": 2, "multipleOf": 2 },
          "height": { "type": "integer", "minimum": 2, "multipleOf": 2 },
          "duration": { "type": "number", "exclusiveMinimum": 0 },
          "credit": { "type": ["string", "null"] }
        }
      }
    },
    "youtube": {
      "type": "object",
      "propertyNames": { "pattern": "^y[0-9]{2,}$" },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "start", "end", "title", "credit"],
        "properties": {
          "id": { "type": "string", "pattern": "^[A-Za-z0-9_-]{11}$" },
          "start": { "type": "number", "minimum": 0 },
          "end": { "type": "number", "exclusiveMinimum": 0 },
          "title": { "type": "string" },
          "credit": { "type": "string" }
        }
      }
    },
    "slides": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "n", "title", "text", "states"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[0-9A-F]{8}-[0-9A-F]{4}-[0-9A-F]{4}-[0-9A-F]{4}-[0-9A-F]{12}$"
          },
          "n": { "type": "integer", "minimum": 1 },
          "title": { "type": "string", "minLength": 1 },
          "text": { "type": "string" },
          "states": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["image", "overlay", "transition", "media"],
              "properties": {
                "image": { "$ref": "#/$defs/webp" },
                "overlay": { "oneOf": [{ "$ref": "#/$defs/webp" }, { "type": "null" }] },
                "image2x": { "$ref": "#/$defs/webp" },
                "overlay2x": { "oneOf": [{ "$ref": "#/$defs/webp" }, { "type": "null" }] },
                "transition": { "enum": ["none", "dissolve"] },
                "media": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["kind", "ref", "rect"],
                    "properties": {
                      "kind": { "enum": ["video", "youtube"] },
                      "ref": { "type": "string", "pattern": "^[vy][0-9]{2,}$" },
                      "rect": {
                        "type": "array",
                        "minItems": 4,
                        "maxItems": 4,
                        "items": { "type": "number" }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "changelog": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["date", "note"],
        "properties": {
          "date": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
          "note": { "type": "string" }
        }
      }
    }
  },
  "$defs": {
    "webp": { "type": "string", "pattern": "^[0-9a-f]{16}\\.webp$" },
    "mp4": { "type": "string", "pattern": "^[0-9a-f]{16}\\.mp4$" }
  }
}
